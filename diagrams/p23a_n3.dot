graph G {
  node [shape=circle, fontsize=10, width=0.3, fixedsize=true];
  overlap=false; splines=true;
  0 [label="1"];
  1 [label="2"];
  2 [label="3"];
  3 [label="4"];
  4 [label="5"];
  5 [label="6"];
  6 [label="7"];
  7 [label="8"];
  8 [label="9"];
  9 [label="10"];
  0 -- 1;
  0 -- 3;
  0 -- 5 [style=dashed, color=gray50];
  0 -- 6 [style=dashed, color=gray50];
  0 -- 7 [style=dashed, color=gray50];
  0 -- 8 [style=dashed, color=gray50];
  0 -- 9 [style=dashed, color=gray50];
  1 -- 2 [label="4", fontsize=9];
  1 -- 3 [style=dashed, color=gray50];
  1 -- 6 [label="4", fontsize=9];
  1 -- 8 [style=dashed, color=gray50];
  1 -- 9;
  2 -- 4 [style=dashed, color=gray50];
  2 -- 6 [label="4", fontsize=9];
  2 -- 7 [style=dashed, color=gray50];
  2 -- 8 [style=dashed, color=gray50];
  2 -- 9 [style=dashed, color=gray50];
  3 -- 4 [label="4", fontsize=9];
  3 -- 5 [style=dashed, color=gray50];
  3 -- 7 [label="4", fontsize=9];
  3 -- 9;
  4 -- 5 [style=dashed, color=gray50];
  4 -- 6 [style=dashed, color=gray50];
  4 -- 7 [label="4", fontsize=9];
  4 -- 9 [style=dashed, color=gray50];
  5 -- 7 [style=dashed, color=gray50];
  5 -- 8 [style=dashed, color=gray50];
  5 -- 9 [style=dashed, color=gray50];
  6 -- 7 [style=dashed, color=gray50];
  6 -- 8 [style=dashed, color=gray50];
  8 -- 9 [style=dashed, color=gray50];
}
