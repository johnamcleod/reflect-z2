graph G {
  node [shape=circle, fontsize=10, width=0.3, fixedsize=true];
  overlap=false; splines=true;
  0 [label="1"];
  1 [label="2"];
  2 [label="3"];
  3 [label="4"];
  4 [label="5"];
  5 [label="6"];
  6 [label="7"];
  0 -- 1;
  0 -- 4 [label="8", fontsize=9];
  0 -- 6 [label="4", fontsize=9];
  1 -- 2;
  2 -- 3 [label="4", fontsize=9];
  2 -- 5 [label="8", fontsize=9];
  3 -- 6 [style=dashed, color=gray50];
}
